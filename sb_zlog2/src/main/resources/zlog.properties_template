
# 输出到控制台

# 这行是固定值，值只能是CONSOLE，表示输出到控制台
zlog.console.name=CONSOLE

# 可选true和false，表示是否启用输出到控制台
zlog.console.enable=true

# 表示输出的最低日志级别，不低于此级别的LOG.XX都会输出
zlog.console.level=TRACE

# 自定义输出的日志格式，本示例意为：
# [输出日志的日期时间]-[本条日志级别(取决于LOG.XX的这个XX是什么)]-[当前线程名]-[当前类名::当前方法名@LOG.XX那行代码的行号] : [具体的日志信息]
# 如：代码中使用 LOG.info("启动成功,time={}", LocalDateTime.now()); 
# 则本示例配置会输出如下日志：
# [2025-09-02T01:18:14.011]-[INFO]-[zf-Thread]-[com.vo.Zf1Application::main@16] : [启动成功,time=2025-09-02T01:18:14.011]

zlog.console.pattern=[%DATE_TIME]-[%LEVEL]-[%THREAD]-[%CLASS_NAME::%METHOD@%LINE_NUMBER] : [%MESSAGE]

# 输出到文件
# 这行是固定值，值只能是FILE，表示输出到文件
zlog.file.name=FILE

# 可选true和false，表示是否启用输出到文件
zlog.file.enable=true

# 表示输出的最低日志级别，不低于此级别的LOG.XX都会输出
zlog.file.level=TRACE

# 同上 zlog.console.pattern配置项
zlog.file.pattern=[%DATE_TIME]-[%LEVEL]-[%THREAD]-[%CLASS_NAME::%METHOD@%LINE_NUMBER] : [%MESSAGE]

# 指定的日志文件目录，如程序以jar方式运行，则默认自动在jar同目录下新建一个log目录并使用log目录
# 如在IDE中运行，则在源码同目录下新建一个log目录并使用log目录
# 也可手动指定一个目录，如：zlog.file.filePath=/root/jar/zf1/log
zlog.file.filePath=[程序运行目录下的log目录]

# 日志文件名称，不指定，则默认为工程名，如：工程名为myApp，则本想默认值为myApp.log
# 也可手动指定一个名称，如：zlog.file.fileName=/root/jar/zf1/log/myApp.log
zlog.file.fileName=[程序名称.log]

# 单个日志文件最大多少MB，达到此值则新建一个.log文件用来存放日志，并把就日志文件压缩打包放在当前目录下
zlog.file.fileSize=100



